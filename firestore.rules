rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Trusted Contacts sub-collection: users/{userId}/trustedContacts/{contactId}
      match /trustedContacts/{contactId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Backwards-compatible emergencyContacts sub-collection
      match /emergencyContacts/{contactId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Alerts audit sub-collection: users/{userId}/alerts/{alertId}
      match /alerts/{alertId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Backwards-compatible emergencyAlerts sub-collection
      match /emergencyAlerts/{alertId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Deny all other cross-user access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
